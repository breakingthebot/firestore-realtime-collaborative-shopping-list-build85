# Application Configuration
HOST=127.0.0.1
PORT=8000
APP_ENV=development

# Google Cloud Firestore Configuration
GCP_PROJECT_ID=local-shopping-list-project
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=
USE_EMBEDDED_ENGINE=true

# Real-Time & Offline Sync Configuration
SYNC_CONFLICT_STRATEGY=LAST_WRITE_WINS
WS_HEARTBEAT_INTERVAL_SEC=30
